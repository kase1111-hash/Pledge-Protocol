# Blockchain
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
PRIVATE_KEY=your_private_key_here

# API
PORT=3000
NODE_ENV=development

# Database: "postgresql" persists data (schema is created on startup);
# "memory" is for development only and loses everything on restart.
# Only one API instance may run per database: a second one refuses to start.
DATABASE_TYPE=postgresql
DATABASE_URL=postgresql://user:password@localhost:5432/pledge_protocol

# Access control
# Comma-separated wallet addresses granted the admin role (register oracles,
# settle payments, assign roles). Admins can grant roles to others via the API.
ADMIN_ADDRESSES=
# Address allowed to attest milestones for the built-in "oracle_manual_1" oracle
ORACLE_MANUAL_ATTESTOR=

# Commemorative token storage. Without IPFS or Arweave credentials, images
# and metadata are kept by the API and served from /v1/commemoratives/assets.
# STORAGE_PROVIDER=local|ipfs|arweave (default: first one configured)
STORAGE_PROVIDER=
# IPFS through Pinata: key and secret, or a JWT
IPFS_API_URL=https://api.pinata.cloud
IPFS_API_KEY=
IPFS_API_SECRET=
PINATA_JWT=
IPFS_GATEWAY=https://ipfs.io/ipfs
# Arweave through an Irys/Bundlr node: the wallet as JWK JSON, or a file path
ARWEAVE_WALLET=
ARWEAVE_WALLET_FILE=
BUNDLER_URL=https://node1.irys.xyz

# Notifications. Channels without credentials fail with an explanatory error.
# APP_URL is the web app that notification links point to.
APP_URL=https://app.example.com
EMAIL_PROVIDER=sendgrid            # sendgrid | mailgun
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
EMAIL_FROM=notifications@example.com
EMAIL_FROM_NAME=Pledge Protocol
PUSH_PROVIDER=firebase             # firebase | onesignal
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Exchange rates come from CoinGecko; settlements are refused when no rate
# from the last ten minutes is available
PRICE_FEED_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# Gas Reporter
REPORT_GAS=true

# Webhook, integration and API oracle requests refuse private, loopback and
# link-local destinations. Set to true only for local development against
# services on your machine.
ALLOW_PRIVATE_WEBHOOK_TARGETS=false

# Public URL of this API; OAuth providers redirect to
# $BASE_URL/v1/integrations/oauth/callback
BASE_URL=https://api.example.com

# OAuth apps for integrations (leave empty to disable that provider)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
